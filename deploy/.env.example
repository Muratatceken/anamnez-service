# /opt/anamnez/.env  (docker compose ve systemd okur)
API_BIND=10.0.0.5          # host'un iç ağa bakan IP'si; 127.0.0.1 = yalnızca lokal
# VLLM_TAG=v0.19.1         # yalnızca Mod B (GPU)
# API anahtarı env'de DEĞİL: deploy/api_key.txt (docker secret)
CLOUD_PROVIDER=anthropic   # anthropic | gemini
CLOUD_MODEL=claude-opus-5  # gemini için gemini-pro-latest (en doğru) / gemini-3.8-flash (hızlı)
CLOUD_KEY_FILE=./anthropic_key.txt   # gemini için ./gemini_key.txt (chmod 600; repoya girmez)
