# /etc/systemd/system/anamnez-compose.service — sunucu açılışında yığını kaldır, nftables'ı Docker'dan SONRA uygula
[Unit]
Description=Anamnez kapalı devre servisi (docker compose)
Requires=docker.service
After=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/anamnez
EnvironmentFile=/opt/anamnez/.env
ExecStartPre=/usr/sbin/nft -f /opt/anamnez/deploy/nftables.conf
ExecStart=/usr/bin/docker compose -f deploy/docker-compose.yml up -d
ExecStop=/usr/bin/docker compose -f deploy/docker-compose.yml down

[Install]
WantedBy=multi-user.target
